<Window x:Class="AlKatta.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AlKatta.ViewModels"
        Title="القاطع — AL KATTA" Height="740" Width="1160"
        MinHeight="580" MinWidth="960"
        FlowDirection="RightToLeft"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Ideal"
        Background="{StaticResource WindowGrad}"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============================ SIDEBAR ============================ -->
        <Border Grid.Column="0" Background="#11141E" BorderBrush="{StaticResource Border}" BorderThickness="1,0,0,0">
            <Grid Margin="20,22,20,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- brand -->
                <StackPanel Grid.Row="0">
                    <Border Width="58" Height="58" CornerRadius="17" Background="{StaticResource AccentGrad}"
                            HorizontalAlignment="Right">
                        <Grid>
                            <TextBlock x:Name="LogoFallback" Text="ق" FontSize="28" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Image x:Name="LogoImage" Stretch="Uniform" Margin="8" Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                    <TextBlock Text="القاطع" FontSize="23" FontWeight="Bold" Margin="0,14,0,0"/>
                    <TextBlock Text="AL KATTA — متحكّم الشبكة" FontSize="11.5"
                               Foreground="{StaticResource SubText}" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- live stat tiles -->
                <Grid Grid.Row="1" Margin="0,24,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Card}" Padding="12,11" Margin="0,0,5,5">
                        <StackPanel>
                            <TextBlock Text="{Binding Devices.Count}" FontSize="22" FontWeight="Bold"/>
                            <TextBlock Text="أجهزة" FontSize="11" Foreground="{StaticResource SubText}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource Card}" Padding="12,11" Margin="5,0,0,5">
                        <StackPanel>
                            <TextBlock Text="{Binding ActiveLimits}" FontSize="22" FontWeight="Bold"
                                       Foreground="{StaticResource Warn}"/>
                            <TextBlock Text="محدودة" FontSize="11" Foreground="{StaticResource SubText}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}" Padding="12,11" Margin="0,5,5,0">
                        <StackPanel>
                            <TextBlock Text="{Binding TotalDownKbps, Converter={StaticResource Rate}}"
                                       FontSize="15" FontWeight="Bold" Foreground="{StaticResource Cyan}"
                                       FlowDirection="LeftToRight" HorizontalAlignment="Right"/>
                            <TextBlock Text="▼ التحميل الآن" FontSize="11" Foreground="{StaticResource SubText}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}" Padding="12,11" Margin="5,5,0,0">
                        <StackPanel>
                            <TextBlock Text="{Binding TotalUpKbps, Converter={StaticResource Rate}}"
                                       FontSize="15" FontWeight="Bold" Foreground="{StaticResource Violet}"
                                       FlowDirection="LeftToRight" HorizontalAlignment="Right"/>
                            <TextBlock Text="▲ الرفع الآن" FontSize="11" Foreground="{StaticResource SubText}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- footer / disclaimer -->
                <StackPanel Grid.Row="3">
                    <Border Height="1" Background="{StaticResource Border}" Margin="0,0,0,12"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Ellipse Width="7" Height="7" Fill="{StaticResource Success}" VerticalAlignment="Center"/>
                        <TextBlock Text="جاهز" FontSize="11.5" Foreground="{StaticResource SubText}" Margin="7,0,0,0"/>
                    </StackPanel>
                    <TextBlock Text="للاستخدام فقط على شبكة تملكها أو تديرها."
                               FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="16"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================= MAIN ============================= -->
        <Grid Grid.Column="1" Margin="22,20,22,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- interface bar -->
            <Border Grid.Row="0" Style="{StaticResource Card}" Padding="14,11" Margin="0,0,0,14">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="الواجهة" Foreground="{StaticResource SubText}" FontWeight="SemiBold"
                               Margin="0,0,10,0"/>
                    <ComboBox Width="380"
                              ItemsSource="{Binding Interfaces}"
                              SelectedItem="{Binding SelectedInterface}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding FriendlyName}" TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Content="فحص الشبكة" Command="{Binding ScanCommand}"
                            Style="{StaticResource PrimaryButton}" MinWidth="128" Margin="12,0,0,0"/>
                    <Button Content="تحرير الكل" Command="{Binding ReleaseAllCommand}"
                            Style="{StaticResource GhostButton}" Margin="8,0,0,0"/>
                </StackPanel>
            </Border>

            <!-- device list -->
            <Grid Grid.Row="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Padding="0,0,4,0">
                    <ItemsControl ItemsSource="{Binding Devices}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="13,11" Margin="0,0,0,9">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource Card}">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource SurfaceHi}"/>
                                                    <Setter Property="BorderBrush" Value="{StaticResource BorderHi}"/>
                                                </Trigger>
                                                <DataTrigger Binding="{Binding LimitEnabled}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{StaticResource Warn}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- avatar -->
                                        <Border Grid.Column="0" Width="42" Height="42" CornerRadius="12"
                                                Background="{StaticResource AccentGrad}" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName, Converter={StaticResource FirstLetter}}"
                                                       FontSize="17" FontWeight="Bold" Foreground="White"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- name + meta + rename -->
                                        <StackPanel Grid.Column="1" Margin="13,0,10,0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding DisplayName}" FontSize="14.5" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <Border Style="{StaticResource Pill}" Margin="8,0,0,0" Background="#23314F"
                                                        Visibility="{Binding IsGateway, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="البوابة" FontSize="10.5" FontWeight="SemiBold"
                                                               Foreground="{StaticResource AccentHi}"/>
                                                </Border>
                                                <Border Style="{StaticResource Pill}" Margin="8,0,0,0" Background="#1E3A2E"
                                                        Visibility="{Binding IsSelf, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="هذا الجهاز" FontSize="10.5" FontWeight="SemiBold"
                                                               Foreground="{StaticResource Success}"/>
                                                </Border>
                                                <Border Margin="8,0,0,0" Background="#3A2E12">
                                                    <Border.Style>
                                                        <Style TargetType="Border" BasedOn="{StaticResource Pill}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding Status}" FontSize="10.5" FontWeight="SemiBold"
                                                               Foreground="{StaticResource Warn}"/>
                                                </Border>
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight" Margin="0,3,0,0">
                                                <TextBlock Text="{Binding IpText}" FontSize="11.5" Foreground="{StaticResource SubText}"/>
                                                <TextBlock Text="•" FontSize="11.5" Foreground="{StaticResource Muted}" Margin="7,0"/>
                                                <TextBlock Text="{Binding MacKey}" FontSize="11.5" Foreground="{StaticResource SubText}"/>
                                                <TextBlock Text="•" FontSize="11.5" Foreground="{StaticResource Muted}" Margin="7,0"/>
                                                <TextBlock Text="{Binding Vendor}" FontSize="11.5" Foreground="{StaticResource SubText}"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="150"/>
                                            </StackPanel>

                                            <TextBox Text="{Binding CustomName, UpdateSourceTrigger=LostFocus}"
                                                     Width="210" HorizontalAlignment="Left" Margin="0,6,0,0"
                                                     Height="28" FontSize="11.5"
                                                     ToolTip="اسم مخصّص (يُحفظ تلقائيًا)"/>
                                        </StackPanel>

                                        <!-- live rates -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" MinWidth="112"
                                                    FlowDirection="LeftToRight" Margin="6,0,12,0">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                <TextBlock Text="▼" FontSize="11.5" Foreground="{StaticResource Cyan}"/>
                                                <TextBlock Text="{Binding LiveDownKbps, Converter={StaticResource Rate}}"
                                                           FontSize="12.5" FontWeight="SemiBold" Margin="6,0,0,0"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="▲" FontSize="11.5" Foreground="{StaticResource Violet}"/>
                                                <TextBlock Text="{Binding LiveUpKbps, Converter={StaticResource Rate}}"
                                                           FontSize="12.5" FontWeight="SemiBold" Margin="6,0,0,0"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- limit inputs -->
                                        <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="8,0">
                                            <TextBlock Text="الحد (Kbps)" FontSize="10" Foreground="{StaticResource SubText}"
                                                       HorizontalAlignment="Center" Margin="0,0,0,5"/>
                                            <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight">
                                                <TextBlock Text="▼" FontSize="10.5" Foreground="{StaticResource Cyan}" Margin="0,0,4,0"/>
                                                <TextBox Text="{Binding DownKbps, UpdateSourceTrigger=PropertyChanged}"
                                                         Width="58" Height="30" TextAlignment="Center"/>
                                                <TextBlock Text="▲" FontSize="10.5" Foreground="{StaticResource Violet}" Margin="9,0,4,0"/>
                                                <TextBox Text="{Binding UpKbps, UpdateSourceTrigger=PropertyChanged}"
                                                         Width="58" Height="30" TextAlignment="Center"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- enable toggle -->
                                        <StackPanel Grid.Column="4" VerticalAlignment="Center" Margin="10,0">
                                            <ToggleButton Style="{StaticResource Switch}"
                                                          IsChecked="{Binding LimitEnabled, UpdateSourceTrigger=PropertyChanged}"
                                                          HorizontalAlignment="Center"/>
                                            <TextBlock Text="تفعيل" FontSize="10" Foreground="{StaticResource SubText}"
                                                       HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                        </StackPanel>

                                        <!-- actions -->
                                        <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                                            <Button Content="تطبيق" Style="{StaticResource ChipPrimary}"
                                                    Command="{Binding DataContext.ApplyCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Content="قطع" Style="{StaticResource ChipDanger}"
                                                    Command="{Binding DataContext.CutCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Content="تحرير" Style="{StaticResource ChipGhost}"
                                                    Command="{Binding DataContext.ReleaseCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- empty state -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding Devices.Count, Converter={StaticResource EmptyToVis}}">
                    <Border Width="76" Height="76" CornerRadius="22" Background="{StaticResource Surface}"
                            BorderBrush="{StaticResource Border}" BorderThickness="1" HorizontalAlignment="Center">
                        <TextBlock Text="📡" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="لا توجد أجهزة بعد" FontSize="16" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,16,0,0"/>
                    <TextBlock Text="اختر الواجهة واضغط «فحص الشبكة» لاكتشاف الأجهزة المتصلة."
                               FontSize="13" Foreground="{StaticResource SubText}"
                               HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>
            </Grid>

            <!-- status bar -->
            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14,9" Margin="0,14,0,0">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource Accent}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding StatusLine}" Foreground="{StaticResource Text}"
                               FontSize="12.5" Margin="9,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
