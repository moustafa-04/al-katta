<Window x:Class="AlKatta.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AlKatta.ViewModels"
        Title="القاطع — AL KATTA" Height="640" Width="1080"
        FlowDirection="RightToLeft"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Panel}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="#3A3D45"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <!-- keep IP / MAC / numbers left-to-right for readability -->
        <Style x:Key="Ltr" TargetType="TextBlock">
            <Setter Property="FlowDirection" Value="LeftToRight"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- top bar -->
        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,10">
            <TextBlock Text="الواجهة:" Margin="0,0,8,0" FontWeight="SemiBold"/>
            <ComboBox Width="380" DockPanel.Dock="Left"
                      ItemsSource="{Binding Interfaces}"
                      SelectedItem="{Binding SelectedInterface}"
                      DisplayMemberPath="FriendlyName"/>
            <Button Content="فحص" Command="{Binding ScanCommand}" MinWidth="90" Margin="12,0,0,0"
                    FontWeight="SemiBold" Background="{StaticResource Accent}"/>
            <Button Content="تحرير الكل" Command="{Binding ReleaseAllCommand}"
                    DockPanel.Dock="Left"/>
        </DockPanel>

        <!-- device grid (LTR so columns + numbers stay conventional) -->
        <DataGrid Grid.Row="1"
                  FlowDirection="LeftToRight"
                  ItemsSource="{Binding Devices}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  Background="{StaticResource Panel}"
                  RowBackground="#2A2C33" AlternatingRowBackground="#2F323A"
                  Foreground="{StaticResource Text}"
                  BorderBrush="#3A3D45"
                  IsReadOnly="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="الجهاز" Binding="{Binding DisplayName}" Width="180" IsReadOnly="True"/>
                <DataGridTextColumn Header="اسم مخصّص" Width="150"
                                    Binding="{Binding CustomName, UpdateSourceTrigger=LostFocus}"/>
                <DataGridTextColumn Header="IP" Binding="{Binding IpText}" Width="120" IsReadOnly="True"/>
                <DataGridTextColumn Header="الشركة" Binding="{Binding Vendor}" Width="110" IsReadOnly="True"/>
                <DataGridTextColumn Header="MAC" Binding="{Binding MacKey}" Width="140" IsReadOnly="True"/>

                <DataGridTextColumn Header="↓ مباشر (Kbps)" Width="95" IsReadOnly="True"
                                    Binding="{Binding LiveDownKbps, StringFormat=N0}"/>
                <DataGridTextColumn Header="↑ مباشر (Kbps)" Width="95" IsReadOnly="True"
                                    Binding="{Binding LiveUpKbps, StringFormat=N0}"/>

                <DataGridTextColumn Header="↓ حد (Kbps)" Width="90"
                                    Binding="{Binding DownKbps, UpdateSourceTrigger=PropertyChanged}"/>
                <DataGridTextColumn Header="↑ حد (Kbps)" Width="90"
                                    Binding="{Binding UpKbps, UpdateSourceTrigger=PropertyChanged}"/>

                <DataGridCheckBoxColumn Header="تفعيل" Width="50"
                                        Binding="{Binding LimitEnabled, UpdateSourceTrigger=PropertyChanged}"/>

                <DataGridTemplateColumn Header="إجراءات" Width="230">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="تطبيق"
                                        Command="{Binding DataContext.ApplyCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"/>
                                <Button Content="قطع"
                                        Command="{Binding DataContext.CutCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"/>
                                <Button Content="تحرير"
                                        Command="{Binding DataContext.ReleaseCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="الحالة" Binding="{Binding Status}" Width="*" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- status bar -->
        <Border Grid.Row="2" Background="{StaticResource Panel}" CornerRadius="4" Margin="0,10,0,0" Padding="10,6">
            <DockPanel>
                <TextBlock Text="{Binding StatusLine}" Foreground="{StaticResource SubText}"/>
                <TextBlock DockPanel.Dock="Left" Foreground="{StaticResource SubText}"
                           Text="للاستخدام فقط على شبكة تملكها أو تديرها."/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
